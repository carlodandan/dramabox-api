# DramaBox API Server Configuration

# Server Port
PORT=3000

# DramaBox language: 'in' (Indonesian), 'en' (English), 'zh' (Chinese), etc.
DRAMABOX_LANGUAGE=in

# Request timeout in milliseconds
DRAMABOX_TIMEOUT=30000

# Maximum request retries
DRAMABOX_MAX_RETRIES=3

# Delay between requests in ms
DRAMABOX_REQUEST_DELAY=1000

# Optional Outbound Proxy (HTTP/HTTPS) for datacenter/cloud deployment
# PROXY_URL=http://user:pass@proxy-host:port
