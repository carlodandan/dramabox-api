{
  "name": "dramabox-api",
  "version": "1.0.0",
  "description": "DramaBox REST API & Video Streaming Service",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "dramabox",
    "api",
    "rest-api",
    "streaming",
    "video-streaming",
    "short-drama",
    "cloudflare-workers",
    "vercel",
    "express"
  ],
  "license": "MIT",
  "dependencies": {
    "@zhadev/dramabox": "^0.0.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "supertest": "^7.3.2",
    "wrangler": "^4.162.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261113.1": true
  }
}
